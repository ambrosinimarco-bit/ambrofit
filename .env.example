# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── Groq (Whisper transcription) ────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ─── Strava ───────────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_WEBHOOK_VERIFY_TOKEN=your_random_secret_string_here
STRAVA_REDIRECT_URI=https://your-domain.com/api/strava/callback

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-domain.com
SECRET_KEY=your_random_secret_key_here
ENVIRONMENT=development

# ─── Defaults (utente singolo) ────────────────────────────────────────────────
DEFAULT_USER_TELEGRAM_ID=your_telegram_user_id_here
DEFAULT_DAILY_CALORIE_GOAL=2200
DEFAULT_PROTEIN_GOAL=160
DEFAULT_CARBS_GOAL=220
DEFAULT_FAT_GOAL=80
